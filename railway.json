{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "./start.sh",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "environments": {
    "production": {
      "deploy": {
        "numReplicas": 2,
        "healthcheckPath": "/api/health"
      }
    },
    "staging": {
      "deploy": {
        "numReplicas": 1,
        "healthcheckPath": "/api/health"
      }
    }
  }
}
